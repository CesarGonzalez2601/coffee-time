rules_version = '2';

// Reglas de Coffee Time. Se publican con `firebase deploy --only firestore:rules`
// o copiándolas en la consola (Firestore Database → Reglas).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMINISTRATOR';
    }

    // Perfiles: cada quien lee el suyo y nadie se cambia el rol ni se reactiva.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'active', 'createdAt'])
        && request.resource.data.role == 'CASHIER'
        && request.resource.data.active == true;

      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));

      allow delete: if false;
    }

    // Colecciones del café
    match /productos/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /ordenes/{id} {
      allow read, write: if signedIn();
    }

    match /pagos/{id} {
      allow read, write: if signedIn();
    }

    match /movimientos_inventario/{id} {
      allow read, write: if signedIn();
    }

    match /cierres_caja/{id} {
      allow read, write: if signedIn();
    }

    match /contadores/{coleccion} {
      allow read, write: if signedIn();
    }
  }
}
